with "gnatcoll_core.gpr";
with "aws";

project Spcloud_Config_Client is

for Languages use ("Ada");
    for Library_Name use "spcloud-config-client";
    for Source_Dirs use ("src/**");
    for Object_Dir use "obj";
    for Library_Dir use ".";
    for Library_Kind use "Relocatable";

   package Naming is
      for Spec ("Cloud_Property_Source") use "p-source.ads";
      for Body ("Cloud_Property_Source") use "p-source.adb";

      for Spec ("Cloud_Config_Service_Client") use "p-client.ads";
      for Body ("Cloud_Config_Service_Client") use "p-client.adb";
   end Naming;

   

end Spcloud_Config_Client;
